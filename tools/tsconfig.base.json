{
  "compilerOptions": {
    "target": "es2017",
    "module": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noImplicitOverride": true,
    "sourceMap": false,
    "declaration": true,
    "declarationMap": false
  }
}
