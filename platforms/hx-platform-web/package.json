{
  "name": "@heleonix/hx-platform-web",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "description": "Web implementation of the Heleonix framework.",
  "author": "Heleonix - Hennadii Lutsyshyn",
  "license": "MIT",
  "homepage": "https://github.com/Heleonix/heleonix",
  "bugs": "https://github.com/Heleonix/heleonix/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Heleonix/heleonix.git",
    "directory": "platforms/hx-platform-web"
  },
  "keywords": [],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist temp",
    "build": "node tools/generateMeta.mjs && rollup -c",
    "dts": "api-extractor run -l",
    "test": "node --experimental-strip-types spec/run.ts"
  },
  "peerDependencies": {
    "@heleonix/hx-core": "workspace:*",
    "@heleonix/hx-language": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.js"
    },
    "./hx.meta.json": {
      "hxmeta": "./hx.meta.json",
      "default": "./hx.meta.json"
    }
  },
  "files": [
    "dist/cjs/index.cjs",
    "dist/esm/index.js",
    "dist/types/index.d.ts",
    "hx.meta.json"
  ],
  "devDependencies": {
    "@vscode/web-custom-data": "^0.6.3"
  }
}
