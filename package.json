{
  "name": "heleonix",
  "version": "1.0.0",
  "type": "module",
  "keywords": [],
  "author": "Heleonix - Hennadii Lutsyshyn",
  "license": "MIT",
  "private": true,
  "description": "The heleonix framework.",
  "scripts": {
    "clean": "rimraf temp && pnpm -r run clean",
    "build": "pnpm clean && pnpm -r run build",
    "dts": "pnpm -r --if-present run dts",
    "docfx": "pnpm exec api-documenter yaml -i temp/docfx/input -o temp/docfx/output",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.18.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-documenter": "^7.30.0",
    "@microsoft/api-extractor": "^7.58.2",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "html-webpack-plugin": "^5.6.6",
    "husky": "^9.1.7",
    "jasmine": "^6.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.1",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "webpack": "^5.106.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  }
}
