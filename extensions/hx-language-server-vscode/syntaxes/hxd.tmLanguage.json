{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Heleonix Framework Dictionary",
  "scopeName": "source.hxd",
  "patterns": [
    { "include": "#frontmatter" },
    { "include": "source.json.comments" }
  ],
  "repository": {
    "frontmatter": {
      "name": "meta.frontmatter.hxd",
      "begin": "\\A\\s*(---)[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.frontmatter.begin.hxd" }
      },
      "end": "^[ \\t]*(---)[ \\t]*$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.frontmatter.end.hxd" }
      },
      "patterns": [
        { "match": "#.*$", "name": "comment.line.number-sign.frontmatter.hxd" },
        {
          "match": "^[ \\t]*([A-Za-z_][\\w-]*)[ \\t]*(:)[ \\t]*(.*)$",
          "captures": {
            "1": { "name": "entity.name.tag.frontmatter.hxd" },
            "2": { "name": "punctuation.separator.key-value.hxd" },
            "3": { "name": "string.unquoted.frontmatter.hxd" }
          }
        }
      ]
    }
  }
}
