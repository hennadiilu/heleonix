{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Heleonix Framework Theme",
  "scopeName": "source.hxt",
  "patterns": [
    {
      "include": "source.hxs#frontmatter"
    },
    {
      "include": "source.hxs#keyframeSelector"
    },
    {
      "include": "#group"
    },
    {
      "include": "source.hxs#body"
    }
  ],
  "repository": {
    "group": {
      "match": "^\\s*([A-Za-z_][\\w-]*)\\s*(?=\\{)",
      "captures": {
        "1": {
          "name": "entity.name.section.group.hxt"
        }
      }
    }
  }
}
